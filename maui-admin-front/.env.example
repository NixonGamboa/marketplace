# maui-admin-front — variables de entorno
#
# Copia este archivo a `.env.local` y ajusta los valores para tu instancia demo.

# Activa el modo demo (mock repositories). En `false` el panel intenta
# usar los repositories reales que aún no están implementados.
VITE_DEMO_MODE=true

# Usuarios admin sembrados. JSON inline con
# `[{ email, password, name, role: 'owner'|'operator', merchantId }, ...]`.
# Si está vacío o malformado, se usa el fallback hardcoded:
#   - owner@lechemiel.demo / demo1234 (role: owner)
#   - operator@lechemiel.demo / demo1234 (role: operator)
VITE_ADMIN_USERS=

# Número WhatsApp del aliado, formato internacional con +. Sólo se usa como
# semilla del `mockMerchantRepository`; tras el primer seed la fuente es
# `localStorage['maui-admin-merchant']`.
VITE_WHATSAPP_NUMBER=+573000000000
