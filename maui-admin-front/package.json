{
  "name": "maui-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "bash ../scripts/check-types-drift.sh",
    "dev": "vite --port 5174",
    "dev:unified": "cross-env VITE_ADMIN_BASE=/admin/ vite --port 5174",
    "prebuild": "bash ../scripts/check-types-drift.sh",
    "build": "vite build",
    "build:unified": "cross-env VITE_ADMIN_BASE=/admin/ vite build --outDir dist-unified",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.8"
  }
}
