# Copiar a .env.local. Nunca versionar credenciales ni pasarlas por VITE_*.
# APP_ENV expresa el destino de negocio; NODE_ENV expresa el modo del runtime.
# En Vercel Preview: APP_ENV=test, NODE_ENV=production y DB_DRIVER=postgres.
# Local con Postgres acepta solo loopback. Para Neon de test usar APP_ENV=test
# y declarar ambos destinos; producción exige también NODE_ENV=production.
APP_ENV="local"
NODE_ENV="development"
LOG_LEVEL="info"
DB_DRIVER="postgres"

# Sustituir valores de ejemplo antes de iniciar. No contienen secretos reales.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/maui_local"

# Obligatorios para APP_ENV=test/production con Postgres. Declarar los destinos
# verificados, no deducir la branch por etiquetas como dev/main.
# Test y producción deben usar endpoints diferentes, incluso si ambos DB se
# llaman maui. Se acepta hostname Neon directo o pooler del mismo endpoint.
TEST_DATABASE_HOST="ep-test-example.us-east-2.aws.neon.tech"
TEST_DATABASE_NAME="maui_test"
PRODUCTION_DATABASE_HOST="ep-production-example.us-east-2.aws.neon.tech"
PRODUCTION_DATABASE_NAME="maui_production"

# VERCEL_ENV lo inyecta Vercel; no fijarlo en el archivo local.
# Memory solo sirve en desarrollo/pruebas unitarias locales y health responde
# 503 not_connected: no acredita runtime conectado ni persistencia Postgres.

# Auth (T-05): completar con secreto aleatorio base64 de al menos 32 bytes.
# Sin fallback; no guardar el secreto en Git ni en VITE_*. Ejemplo deliberadamente
# vacío: auth responderá 503 hasta configurarlo. Health no depende de auth.
AUTH_JWT_SECRET=""
AUTH_ORIGIN="http://localhost:3000"
# T-09: habilitado solo con APP_ENV=test y store público exclusivo de test.
# Token únicamente del servidor; nunca VITE_*. IDs aceptan prefijo store_.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
TEST_BLOB_STORE_ID=""
TEST_BLOB_PUBLIC_HOST=""
# Preview/producción: origen HTTPS exacto, sin barra final, path ni query.
# Usar una clave diferente por entorno. La audiencia JWT separa test/production.
