# Copiar a .env.local y completar. NUNCA commitear .env.local

# BD — Neon Postgres. Ver https://neon.tech/docs/connect/connect-from-any-app
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/maui?sslmode=require"

# Driver activo: "postgres" | "memory". Usar "memory" en tests locales sin BD.
DB_DRIVER="postgres"

# Runtime
NODE_ENV="development"
LOG_LEVEL="debug"
