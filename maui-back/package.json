{
  "name": "maui-back",
  "version": "0.1.0",
  "private": true,
  "description": "Backend real de MAUI. Vercel Functions + Neon Postgres. Layout portable a AWS Lambda + DynamoDB (ver docs/adr-001-vercel-postgres-first.md).",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/infra/postgres/migrate.ts",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/blob": "2.8.0",
    "drizzle-orm": "^0.36.4",
    "jose": "^6.2.12",
    "pino": "^9.5.0",
    "sharp": "0.35.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.0.0",
    "drizzle-kit": "^0.29.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vercel": "^59.11.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "24.x"
  }
}
